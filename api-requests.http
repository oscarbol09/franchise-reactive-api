# ==============================================================================
# Franchise Reactive API — End-to-End Request Suite (.http / REST Client)
# Compatible with VS Code REST Client and JetBrains HTTP Client
# ==============================================================================
@baseUrl = http://localhost:8080/api/v1/franchises

### 1. Create a new Franchise (Criterion #2)
# @name createFranchise
POST {{baseUrl}}
Content-Type: application/json

{
  "name": "Franquicia Café Colombia"
}

@franchiseId = {{createFranchise.response.body.$.id}}

### 2. [Bonus] Update Franchise Name
PATCH {{baseUrl}}/{{franchiseId}}
Content-Type: application/json

{
  "name": "Franquicia Café Internacional"
}

### 3. Add a new Branch to the Franchise (Criterion #3)
# @name createBranch
POST {{baseUrl}}/{{franchiseId}}/branches
Content-Type: application/json

{
  "name": "Sucursal Medellín"
}

@branchId = {{createBranch.response.body.$.id}}

### 4. [Bonus] Update Branch Name
PATCH {{baseUrl}}/{{franchiseId}}/branches/{{branchId}}
Content-Type: application/json

{
  "name": "Sucursal El Poblado"
}

### 5. Add a primary Product to the Branch (Criterion #4)
# @name createProduct
POST {{baseUrl}}/{{franchiseId}}/branches/{{branchId}}/products
Content-Type: application/json

{
  "name": "Café Origen Antioquia",
  "stock": 140
}

@productId = {{createProduct.response.body.$.id}}

### 6. Modify Product Stock (Criterion #6)
PATCH {{baseUrl}}/{{franchiseId}}/branches/{{branchId}}/products/{{productId}}/stock
Content-Type: application/json

{
  "stock": 280
}

### 7. [Bonus] Update Product Name
PATCH {{baseUrl}}/{{franchiseId}}/branches/{{branchId}}/products/{{productId}}
Content-Type: application/json

{
  "name": "Café Origen Reserva Especial"
}

### 8. Get Top Stock Product per Branch for a Franchise (Criterion #7)
GET {{baseUrl}}/{{franchiseId}}/top-stock-products
Accept: application/json

### 9. Get Full Franchise Hierarchy Detail
GET {{baseUrl}}/{{franchiseId}}
Accept: application/json

### 10. Create & Remove a temporary Product from the Branch (Criterion #5)
# @name createTempProduct
POST {{baseUrl}}/{{franchiseId}}/branches/{{branchId}}/products
Content-Type: application/json

{
  "name": "Producto Edicion Limitada Temporal",
  "stock": 25
}

@tempProductId = {{createTempProduct.response.body.$.id}}

### 10b. Remove the temporary Product from the Branch (Criterion #5)
DELETE {{baseUrl}}/{{franchiseId}}/branches/{{branchId}}/products/{{tempProductId}}

# ==============================================================================
# Negative & Edge-Case Verification (RFC 9457 ProblemDetail Responses)
# ==============================================================================

### 11. Validation Error — Blank Franchise Name (Expected: 400 Bad Request, errorCode=ERR-400)
POST {{baseUrl}}
Content-Type: application/json

{
  "name": "   "
}

### 12. Business Rule Error — Negative Stock Value (Expected: 400 Bad Request, errorCode=ERR-400)
PATCH {{baseUrl}}/{{franchiseId}}/branches/{{branchId}}/products/{{productId}}/stock
Content-Type: application/json

{
  "stock": -15
}

### 13. Resource Not Found — Non-Existent Franchise (Expected: 404 Not Found, errorCode=ERR-404-FRANCHISE)
GET {{baseUrl}}/999999
Accept: application/json

### 14. Conflict Error — Duplicate Product Name in Same Branch (Expected: 409 Conflict, errorCode=ERR-409-PRODUCT)
POST {{baseUrl}}/{{franchiseId}}/branches/{{branchId}}/products
Content-Type: application/json

{
  "name": "Café Origen Reserva Especial",
  "stock": 50
}
